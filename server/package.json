{
  "name": "realtime-collab-docs-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env.local src/index.js",
    "start": "node src/index.js",
    "smoke": "node --env-file=.env.local scripts/smoke.js",
    "migrate": "node --env-file=.env.local scripts/migrate.js",
    "test": "node --test --env-file=.env.local",
    "test:coverage": "node --test --experimental-test-coverage --env-file=.env.local"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.22.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "rate-limit-redis": "4.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "supertest": "7.0.0"
  }
}
