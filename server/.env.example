# ============================================================================
# realtime-collab-docs — SERVER environment TEMPLATE
# Copy to .env.local and fill in. Do NOT put real secrets in this file.
# Generate JWT/WS secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- PostgreSQL (Neon) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Redis (Upstash) ----
REDIS_URL=rediss://default:password@host:port

# ---- JWT ----
JWT_SECRET=replace_with_32_byte_hex
JWT_REFRESH_SECRET=replace_with_32_byte_hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- WebSocket ticket ----
WS_TICKET_SECRET=replace_with_32_byte_hex
WS_TICKET_TTL_SECONDS=30

# ---- Cookies ----
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173

# ---- Yjs persistence ----
YJS_PERSIST_DEBOUNCE_MS=2000
YJS_PERSIST_SNAPSHOT_MS=15000

# ---- Rate limiting ----
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# ---- Post-MVP (optional) ----
EMAIL_API_KEY=
EMAIL_FROM=
